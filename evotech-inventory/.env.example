# ── Demo mode ────────────────────────────────────────────────────────
# Runs the whole app with no server: the data you enter is stored in this
# browser. Use it to try the interface before the backend exists.
NEXT_PUBLIC_DEMO=true

# Skips the PIN screen and runs as a local admin.
NEXT_PUBLIC_AUTH_DISABLED=true

# ── Real backend ─────────────────────────────────────────────────────
# Set NEXT_PUBLIC_DEMO=false and point this at the server.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
